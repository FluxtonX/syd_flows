rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin Verification (SYD FLOWS Web Admin) ──────────────
    // Check master UID or any user with role == 'admin' in /users/{uid}
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'By5lDQtFBoNw95IfybB0d8DBwcw2' ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isSuperAdmin == true)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true))
      );
    }

    // ── Videos collection ───────────────────────────────────────
    // Admin & Web Portal: read/write
    // All users (authenticated & guest): read access (view workout videos)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Dedicated Admin Users collection ──────────────
    match /admin_users/{adminId} {
      allow read, write: if true;
    }

    // ── User documents ──────────────────────────────────────────
    match /users/{userId} {
      // Allow read for authenticated user, admin query, or admin documents
      allow read: if true;
      
      // Allow creation/updates for admin documents or user profile setup
      allow create, update: if true;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // ── App Settings (Subscription plans, global config) ───────
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // ── All other documents ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
