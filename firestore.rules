rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin Verification (SYD FLOWS Web Admin) ──────────────
    // Check master UID or any user with role == 'admin' in /users/{uid}
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'By5lDQtFBoNw95IfybB0d8DBwcw2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true))
      );
    }

    // ── Videos collection ───────────────────────────────────────
    // Admin: full read/write
    // All users (authenticated & guest): read access (view workout videos)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── User documents ──────────────────────────────────────────
    // Flutter app users can read/write only their own document
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      // The app can manage its own profile, but never grant itself premium.
      // A verified payment webhook/Admin SDK writes the subscription field.
      allow create: if isAdmin() ||
          (request.auth != null && request.auth.uid == userId &&
           !('subscription' in request.resource.data));
      allow update: if isAdmin() ||
          (request.auth != null && request.auth.uid == userId &&
           !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['subscription']));
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      match /{allPaths=**} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // ── App Settings (Subscription plans, global config) ───────
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── All other documents ─────────────────────────────────────
    // Keep unknown collections admin-only. Broad authenticated access here
    // would allow a client to create its own entitlement documents.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
