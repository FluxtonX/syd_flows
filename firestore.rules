rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin UID (SYD FLOWS Web Admin) ────────────────────────
    // Only this specific UID can read/write the videos collection.
    // Generated by: node scripts/create-admin.js admin@sydflows.com
    function isAdmin() {
      return request.auth != null &&
             request.auth.uid == 'By5lDQtFBoNw95IfybB0d8DBwcw2';
    }

    // ── Videos collection ───────────────────────────────────────
    // Admin: full read/write
    // Others: no access
    match /videos/{videoId} {
      allow read, write: if isAdmin();
    }

    // ── User documents ──────────────────────────────────────────
    // Flutter app users can read/write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── All other documents ─────────────────────────────────────
    // Authenticated users (Flutter app) can read/write their own data.
    // Admin can access everything.
    match /{document=**} {
      allow read, write: if isAdmin() || request.auth != null;
    }

  }
}
